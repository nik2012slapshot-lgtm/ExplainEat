# Kopiere diese Datei zu ".env" und trage deinen privaten Roboflow-API-Key ein.
# Key holen: https://app.roboflow.com/settings/api
# WICHTIG: .env ist in .gitignore und darf NICHT committet werden.

ROBOFLOW_API_KEY=dein_privater_key_hier

# Optional: externe Rezept-API. Gibt eine JSON-Liste (oder {"recipes": [...]}) im
# gleichen Schema wie explain_eat/recipes.json zurück. Diese Rezepte werden mit
# den lokalen gemischt. Leer lassen = nur lokale Rezepte.